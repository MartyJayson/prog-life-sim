[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/computer/drive_tile.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/generated/flash_drive.svg" id="icon"]

[node name="DriveTile" type="Button"]
custom_minimum_size = Vector2(320, 86)
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"ExplorerTile"
script = ExtResource("script")

[node name="Row" type="HBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 10.0
offset_right = -12.0
offset_bottom = -10.0
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 56)
size_flags_vertical = 4
mouse_filter = 2
texture = ExtResource("icon")
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Row"]
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="Row/Text"]
unique_name_in_owner = true
mouse_filter = 2
text_overrun_behavior = 3
theme_type_variation = &"MailStrong"
theme_override_font_sizes/font_size = 17

[node name="Bar" type="ProgressBar" parent="Row/Text"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 14)
mouse_filter = 2
theme_type_variation = &"DriveBar"
max_value = 1.0
step = 0.0
show_percentage = false

[node name="Detail" type="Label" parent="Row/Text"]
unique_name_in_owner = true
mouse_filter = 2
text_overrun_behavior = 3
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 14

[node name="Actions" type="HBoxContainer" parent="Row/Text"]
unique_name_in_owner = true
visible = false
theme_override_constants/separation = 8

[node name="Plug" type="Button" parent="Row/Text/Actions"]
unique_name_in_owner = true
visible = false
focus_mode = 0
mouse_default_cursor_shape = 2
text = "Plug in"
theme_override_font_sizes/font_size = 16

[node name="Destroy" type="Button" parent="Row/Text/Actions"]
unique_name_in_owner = true
visible = false
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Smash the drive. Its files are gone for good."
text = "Destroy"
theme_type_variation = &"DangerButton"
theme_override_font_sizes/font_size = 16
