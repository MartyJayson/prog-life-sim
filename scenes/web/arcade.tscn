[gd_scene format=3]

[node name="Arcade" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="."]
text = "A new high score at the arcade"
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 38

[node name="Subtitle" type="Label" parent="."]
text = "News OS  /  The Desktop Edition"
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 20

[node name="Article" type="Label" parent="."]
text = "The Games OS team released Snake this morning. The game speeds up with each point, so experienced players have been planning their turns well ahead of the next snack."
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 23

[node name="AllHeadlines" type="Button" parent="."]
text = "All headlines"
focus_mode = 0
mouse_default_cursor_shape = 2
alignment = 0
text_overrun_behavior = 3
metadata/destination = "news.oc"
