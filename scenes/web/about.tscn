[gd_scene format=3]

[node name="About" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="."]
text = "About OS"
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 38

[node name="Subtitle" type="Label" parent="."]
text = "OS 1.0  /  Desktop Edition"
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 20

[node name="Description" type="Label" parent="."]
text = "OS is a fictional desktop environment with a local web, a casino and everyday utilities."
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 23

[node name="Directory" type="Button" parent="."]
text = "Explore the site directory"
focus_mode = 0
mouse_default_cursor_shape = 2
alignment = 0
text_overrun_behavior = 3
metadata/destination = "home.oc"
