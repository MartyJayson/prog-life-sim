[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/web/bank_payments.gd" id="script"]
[ext_resource type="Theme" path="res://scenes/web/bank_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://scenes/web/bank_header.tscn" id="header"]

[node name="BankPayments" type="VBoxContainer"]
size_flags_horizontal = 3
theme = ExtResource("theme")
theme_override_constants/separation = 18
script = ExtResource("script")

[node name="TopBar" parent="." instance=ExtResource("header")]

[node name="Payments" parent="TopBar/Row" index="2"]
disabled = true

[node name="Summary" type="HBoxContainer" parent="."]
theme_override_constants/separation = 16

[node name="Title" type="VBoxContainer" parent="Summary"]
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="Summary/Title"]
mouse_filter = 2
theme_type_variation = &"BankHeading"
theme_override_font_sizes/font_size = 28
text = "Payments due today"

[node name="Date" type="Label" parent="Summary/Title"]
unique_name_in_owner = true
mouse_filter = 2
theme_override_colors/font_color = Color(0.49, 0.545, 0.627, 1)
theme_override_font_sizes/font_size = 17

[node name="Account" type="VBoxContainer" parent="Summary"]
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="Summary/Account"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.49, 0.545, 0.627, 1)
theme_override_font_sizes/font_size = 17
text = "Available balance"
horizontal_alignment = 2

[node name="Balance" type="Label" parent="Summary/Account"]
unique_name_in_owner = true
mouse_filter = 2
theme_type_variation = &"BankHeading"
theme_override_colors/font_color = Color(0.039, 0.165, 0.38, 1)
horizontal_alignment = 2

[node name="PaymentsCard" type="PanelContainer" parent="."]
theme_type_variation = &"BankCard"

[node name="Stack" type="VBoxContainer" parent="PaymentsCard"]
theme_override_constants/separation = 14

[node name="Pending" type="HBoxContainer" parent="PaymentsCard/Stack"]
unique_name_in_owner = true
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="PaymentsCard/Stack/Pending"]
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"BankHeading"
text = "Rent"

[node name="RentAmount" type="Label" parent="PaymentsCard/Stack/Pending"]
unique_name_in_owner = true
mouse_filter = 2
theme_type_variation = &"BankHeading"
theme_override_colors/font_color = Color(0.039, 0.165, 0.38, 1)

[node name="Pay" type="Button" parent="PaymentsCard/Stack/Pending"]
unique_name_in_owner = true
mouse_default_cursor_shape = 2
theme_type_variation = &"BankPrimary"
text = "Pay"

[node name="PaymentError" type="Label" parent="PaymentsCard/Stack"]
unique_name_in_owner = true
visible = false
mouse_filter = 2
theme_override_colors/font_color = Color(0.776, 0.184, 0.235, 1)
theme_override_font_sizes/font_size = 17
text = "Insufficient funds."
autowrap_mode = 3

[node name="Empty" type="Label" parent="PaymentsCard/Stack"]
unique_name_in_owner = true
visible = false
mouse_filter = 2
theme_override_colors/font_color = Color(0.49, 0.545, 0.627, 1)
theme_override_font_sizes/font_size = 18
text = "No payments due today."

[connection signal="pressed" from="PaymentsCard/Stack/Pending/Pay" to="." method="_pay_rent"]

[editable path="TopBar"]
