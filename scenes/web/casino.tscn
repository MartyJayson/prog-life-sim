horizontal_alignment = 1
mouse_filter = 2
theme_type_variation = &"CasinoTitle"
theme_override_font_sizes/font_size = 18

[node name="MaxWin" type="Label" parent="Page/Stack/Hero/Content/Jackpot/Column"]
unique_name_in_owner = true
text = "$ 0"
horizontal_alignment = 1
mouse_filter = 2
theme_type_variation = &"CasinoLogo"
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 46

[node name="Note" type="Label" parent="Page/Stack/Hero/Content/Jackpot/Column"]
text = "top win from a single spin"
