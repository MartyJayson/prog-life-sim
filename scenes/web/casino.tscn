[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/web/casino.gd" id="script"]
[ext_resource type="Theme" path="res://scenes/web/casino_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://scenes/web/casino_header.tscn" id="header"]
[ext_resource type="Script" path="res://scripts/web/marquee_lights.gd" id="lights"]
[ext_resource type="Texture2D" path="res://assets/generated/slots.svg" id="slots_icon"]

[sub_resource type="FontVariation" id="bold"]
variation_embolden = 0.9

[sub_resource type="StyleBoxFlat" id="mini_card"]
bg_color = Color(0.99, 0.97, 0.91, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.75, 0.68, 0.55, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="Casino" type="VBoxContainer"]
size_flags_horizontal = 3
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Page" type="PanelContainer" parent="."]
theme_type_variation = &"CasinoPage"

[node name="Stack" type="VBoxContainer" parent="Page"]
theme_override_constants/separation = 18

[node name="Header" parent="Page/Stack" instance=ExtResource("header")]
section = "lobby"

[node name="Hero" type="PanelContainer" parent="Page/Stack"]
theme_type_variation = &"CasinoHero"

[node name="Content" type="HBoxContainer" parent="Page/Stack/Hero"]
theme_override_constants/separation = 24

[node name="Text" type="VBoxContainer" parent="Page/Stack/Hero/Content"]
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Welcome" type="Label" parent="Page/Stack/Hero/Content/Text"]
text = "WELCOME TO"
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.86, 0.9, 1)
theme_override_font_sizes/font_size = 20

[node name="Name" type="Label" parent="Page/Stack/Hero/Content/Text"]
text = "CASINO OC"
mouse_filter = 2
theme_type_variation = &"CasinoLogo"
theme_override_constants/outline_size = 14
theme_override_font_sizes/font_size = 62

[node name="Tagline" type="Label" parent="Page/Stack/Hero/Content/Text"]
text = "Slots, blackjack and big wins — right in your browser."
autowrap_mode = 3
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.9, 0.93, 1)
theme_override_font_sizes/font_size = 20

[node name="Gap" type="Control" parent="Page/Stack/Hero/Content/Text"]
custom_minimum_size = Vector2(0, 8)
mouse_filter = 2

[node name="Actions" type="HBoxContainer" parent="Page/Stack/Hero/Content/Text"]
theme_override_constants/separation = 14

[node name="PlaySlots" type="Button" parent="Page/Stack/Hero/Content/Text/Actions"]
custom_minimum_size = Vector2(0, 58)
text = "PLAY SLOTS"
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"CasinoGold"
metadata/destination = "casino.oc/slots"

[node name="PlayBlackjack" type="Button" parent="Page/Stack/Hero/Content/Text/Actions"]
text = "Join the 21 table"
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"CasinoLink"
theme_override_font_sizes/font_size = 20
metadata/destination = "casino.oc/blackjack"

[node name="Jackpot" type="PanelContainer" parent="Page/Stack/Hero/Content"]
