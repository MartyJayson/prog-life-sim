theme_type_variation = &"CasinoBanner"

[node name="Column" type="VBoxContainer" parent="Page/Stack/Hero/Content/Jackpot"]
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="Page/Stack/Hero/Content/Jackpot/Column"]
