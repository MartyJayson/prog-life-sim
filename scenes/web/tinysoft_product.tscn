[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/web/tinysoft_product.gd" id="script"]

[node name="Product" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"ShopCard"
script = ExtResource("script")

[node name="Stack" type="VBoxContainer" parent="."]
theme_override_constants/separation = 8

[node name="Picture" type="PanelContainer" parent="Stack"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
mouse_filter = 2
theme_type_variation = &"ShopPicture"

[node name="Glyph" type="Label" parent="Stack/Picture"]
unique_name_in_owner = true
text = "P"
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
theme_type_variation = &"ShopHeading"
theme_override_colors/font_color = Color(1, 1, 1, 0.9)
theme_override_font_sizes/font_size = 54

[node name="Name" type="Label" parent="Stack"]
unique_name_in_owner = true
text = "Product"
mouse_filter = 2
text_overrun_behavior = 3
theme_type_variation = &"ShopStrong"

[node name="Price" type="Label" parent="Stack"]
unique_name_in_owner = true
text = "$0"
mouse_filter = 2
theme_type_variation = &"ShopPrice"

[node name="Add" type="Button" parent="Stack"]
text = "Add to cart"
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopPrimary"

[connection signal="pressed" from="Stack/Add" to="." method="_add_pressed"]
