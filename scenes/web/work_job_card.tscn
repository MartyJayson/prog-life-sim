[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/web/work_job_card.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/web/work_tag.tscn" id="tag"]

[node name="JobCard" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"WorkJob"
script = ExtResource("script")
tag_scene = ExtResource("tag")

[node name="Row" type="HBoxContainer" parent="."]
theme_override_constants/separation = 18

[node name="Logo" type="PanelContainer" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
size_flags_vertical = 0
mouse_filter = 2
theme_type_variation = &"WorkLogo"

[node name="Initials" type="Label" parent="Row/Logo"]
unique_name_in_owner = true
text = "TS"
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
theme_type_variation = &"WorkStrong"
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 24

[node name="Info" type="VBoxContainer" parent="Row"]
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Row/Info"]
unique_name_in_owner = true
text = "Job title"
mouse_filter = 2
autowrap_mode = 3
theme_type_variation = &"WorkHeading"

[node name="Company" type="Label" parent="Row/Info"]
unique_name_in_owner = true
text = "Company · Location"
mouse_filter = 2
autowrap_mode = 3
theme_type_variation = &"WorkMuted"
theme_override_font_sizes/font_size = 17

[node name="Tags" type="HFlowContainer" parent="Row/Info"]
unique_name_in_owner = true
mouse_filter = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="Summary" type="Label" parent="Row/Info"]
unique_name_in_owner = true
text = "Summary"
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 17

[node name="Posted" type="Label" parent="Row/Info"]
unique_name_in_owner = true
text = "Posted today"
mouse_filter = 2
theme_type_variation = &"WorkMuted"
theme_override_font_sizes/font_size = 14

[node name="Side" type="VBoxContainer" parent="Row"]
custom_minimum_size = Vector2(210, 0)
theme_override_constants/separation = 6

[node name="Pay" type="Label" parent="Row/Side"]
unique_name_in_owner = true
text = "$0"
mouse_filter = 2
horizontal_alignment = 2
theme_type_variation = &"WorkPay"

[node name="PayNote" type="Label" parent="Row/Side"]
text = "Paid to your OS Bank account"
mouse_filter = 2
horizontal_alignment = 2
autowrap_mode = 3
theme_type_variation = &"WorkMuted"
theme_override_font_sizes/font_size = 14

[node name="Gap" type="Control" parent="Row/Side"]
custom_minimum_size = Vector2(0, 8)
mouse_filter = 2

[node name="Apply" type="Button" parent="Row/Side"]
unique_name_in_owner = true
text = "Apply now"
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"WorkPrimary"

[node name="Status" type="Label" parent="Row/Side"]
unique_name_in_owner = true
visible = false
text = "Status"
mouse_filter = 2
horizontal_alignment = 2
autowrap_mode = 3
theme_type_variation = &"WorkMuted"
theme_override_font_sizes/font_size = 14

[connection signal="pressed" from="Row/Side/Apply" to="." method="_apply"]
