theme_type_variation = &"CasinoPanel"

[node name="List" type="VBoxContainer" parent="Casino/Stack/Body/Side"]
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Casino/Stack/Body/Side/List"]
text = "PAYTABLE"
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.84, 0.26, 1)
theme_override_fonts/font = SubResource("bold")
theme_override_font_sizes/font_size = 22

[node name="Hint" type="Label" parent="Casino/Stack/Body/Side/List"]
text = "Three matching symbols in a row — horizontally, vertically or diagonally."
