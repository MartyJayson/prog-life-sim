[node name="Poop" type="HBoxContainer" parent="Casino/Stack/Body/Side/List/Pays"]
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="A" type="TextureRect" parent="Casino/Stack/Body/Side/List/Pays/Poop"]
custom_minimum_size = Vector2(26, 26)
texture = ExtResource("poop")
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="B" type="TextureRect" parent="Casino/Stack/Body/Side/List/Pays/Poop"]
