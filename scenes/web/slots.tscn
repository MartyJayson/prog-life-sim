[node name="Separator" type="HSeparator" parent="Casino/Stack/Body/Side/List"]

[node name="Note" type="Label" parent="Casino/Stack/Body/Side/List"]
text = "8 lines, each paid separately, and wins add up. Poop pays nothing and breaks lines. A $ anywhere refunds the bet if there is no line of two or three $."
autowrap_mode = 3
mouse_filter = 2
theme_override_colors/font_color = Color(0.85, 0.78, 0.96, 1)
theme_override_font_sizes/font_size = 16

[node name="Legal" type="Label" parent="Casino/Stack/Body/Side/List"]
text = "Bets and wins are paid in Casino OC tokens."
autowrap_mode = 3
mouse_filter = 2
theme_override_colors/font_color = Color(0.6, 0.52, 0.72, 1)
theme_override_font_sizes/font_size = 14

[node name="AutoStop" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true

[connection signal="pressed" from="Casino/Stack/Body/Machine/Column/Controls/Less" to="." method="_change_bet" binds=[-1]]
[connection signal="pressed" from="Casino/Stack/Body/Machine/Column/Controls/More" to="." method="_change_bet" binds=[1]]
[connection signal="pressed" from="Casino/Stack/Body/Machine/Column/Controls/Spin" to="." method="_spin"]
[connection signal="timeout" from="AutoStop" to="." method="_on_auto_stop"]
