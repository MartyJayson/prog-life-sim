[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/web/bank_theme.tres" id="theme"]

[node name="TopBar" type="PanelContainer"]
theme = ExtResource("theme")
theme_type_variation = &"BankTopBar"

[node name="Row" type="HBoxContainer" parent="."]
theme_override_constants/separation = 20

[node name="Logo" type="Label" parent="Row"]
text = "◆ OS BANK"
mouse_filter = 2
theme_type_variation = &"BankHeading"
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 28

[node name="Accounts" type="Button" parent="Row"]
text = "Accounts"
mouse_default_cursor_shape = 2
theme_type_variation = &"BankNav"
metadata/destination = "bank.oc"

[node name="Payments" type="Button" parent="Row"]
text = "Payments"
mouse_default_cursor_shape = 2
theme_type_variation = &"BankNav"
metadata/destination = "bank.oc/payments"

[node name="Transfers" type="Label" parent="Row"]
text = "Transfers"
mouse_filter = 2
theme_override_colors/font_color = Color(0.678, 0.757, 0.894, 1)
theme_override_font_sizes/font_size = 19

[node name="Deposits" type="Label" parent="Row"]
text = "Savings"
mouse_filter = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.678, 0.757, 0.894, 1)
theme_override_font_sizes/font_size = 19

[node name="Client" type="Label" parent="Row"]
text = "●  My account"
mouse_filter = 2
theme_override_colors/font_color = Color(0.0, 0.85, 0.52, 1)
theme_override_font_sizes/font_size = 17
