[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/qa/qa_check_row.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/generated/check.svg" id="check"]
[ext_resource type="Texture2D" path="res://assets/generated/cross.svg" id="cross"]

[node name="CheckRow" type="Button"]
custom_minimum_size = Vector2(0, 58)
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"QaRow"
script = ExtResource("script")
pass_icon = ExtResource("check")
fail_icon = ExtResource("cross")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 6

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Box" type="PanelContainer" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 30)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"QaBox"

[node name="Mark" type="TextureRect" parent="Margin/Row/Box"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Caption" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Check"
mouse_filter = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 16

[node name="State" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Not tested"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 13

[connection signal="pressed" from="." to="." method="_cycle"]
