[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/my_computer.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/generated/computer.svg" id="computer"]
[ext_resource type="Texture2D" path="res://assets/generated/file.svg" id="file"]
[ext_resource type="PackedScene" path="res://scenes/computer/drive_tile.tscn" id="drive_tile"]

[sub_resource type="ButtonGroup" id="places"]
allow_unpress = false

[sub_resource type="ButtonGroup" id="files"]
allow_unpress = false

[node name="MyComputer" type="VBoxContainer"]
theme_override_constants/separation = 0
script = ExtResource("script")
place_group = SubResource("places")
file_group = SubResource("files")

[node name="Ribbon" type="PanelContainer" parent="."]
theme_type_variation = &"MailRibbon"

[node name="Row" type="HBoxContainer" parent="Ribbon"]
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="Ribbon/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 0)
disabled = true
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Back"
text = "←"

[node name="Up" type="Button" parent="Ribbon/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 0)
disabled = true
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Up one level"
text = "↑"

[node name="Path" type="LineEdit" parent="Ribbon/Row"]
unique_name_in_owner = true
size_flags_horizontal = 3
editable = false
text = "This PC"

[node name="Eject" type="Button" parent="Ribbon/Row"]
unique_name_in_owner = true
visible = false
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Unplug this drive and put it back in the drawer"
text = "Eject"

[node name="DestroyCurrent" type="Button" parent="Ribbon/Row"]
unique_name_in_owner = true
visible = false
focus_mode = 0
mouse_default_cursor_shape = 2
tooltip_text = "Smash this drive. Its files are gone for good."
text = "Destroy"
theme_type_variation = &"DangerButton"

[node name="Panes" type="HBoxContainer" parent="."]
size_flags_vertical = 3
theme_override_constants/separation = 0

[node name="Sidebar" type="PanelContainer" parent="Panes"]
custom_minimum_size = Vector2(220, 0)
theme_type_variation = &"MailSidebar"

[node name="List" type="VBoxContainer" parent="Panes/Sidebar"]
theme_override_constants/separation = 2

[node name="ThisPC" type="Button" parent="Panes/Sidebar/List"]
unique_name_in_owner = true
focus_mode = 0
mouse_default_cursor_shape = 2
toggle_mode = true
button_pressed = true
button_group = SubResource("places")
text = "This PC"
icon = ExtResource("computer")
alignment = 0
theme_type_variation = &"MailFolder"
theme_override_constants/icon_max_width = 24

[node name="Gap" type="Control" parent="Panes/Sidebar/List"]
custom_minimum_size = Vector2(0, 10)
mouse_filter = 2

[node name="DrivesCaption" type="Label" parent="Panes/Sidebar/List"]
text = "  USB DRIVES"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 13

[node name="SideDrives" type="VBoxContainer" parent="Panes/Sidebar/List"]
unique_name_in_owner = true
theme_override_constants/separation = 2

[node name="NoDrives" type="Label" parent="Panes/Sidebar/List"]
unique_name_in_owner = true
text = "  Nothing plugged in"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 14

[node name="Main" type="PanelContainer" parent="Panes"]
size_flags_horizontal = 3
theme_type_variation = &"MailList"

[node name="Scroll" type="ScrollContainer" parent="Panes/Main"]
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Panes/Main/Scroll"]
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Home" type="MarginContainer" parent="Panes/Main/Scroll/Content"]
unique_name_in_owner = true
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18

[node name="Stack" type="VBoxContainer" parent="Panes/Main/Scroll/Content/Home"]
theme_override_constants/separation = 10

[node name="DevicesCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack"]
text = "Devices and drives"
mouse_filter = 2
theme_type_variation = &"MailStrong"

[node name="Devices" type="HFlowContainer" parent="Panes/Main/Scroll/Content/Home/Stack"]
unique_name_in_owner = true
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="LocalDisk" parent="Panes/Main/Scroll/Content/Home/Stack/Devices" instance=ExtResource("drive_tile")]
unique_name_in_owner = true
tooltip_text = "The system drive is locked."

[node name="DrawerCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack"]
text = "In your drawer"
mouse_filter = 2
theme_type_variation = &"MailStrong"

[node name="Drawer" type="HFlowContainer" parent="Panes/Main/Scroll/Content/Home/Stack"]
unique_name_in_owner = true
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="DrawerEmpty" type="HBoxContainer" parent="Panes/Main/Scroll/Content/Home/Stack"]
unique_name_in_owner = true
theme_override_constants/separation = 10

[node name="Text" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/DrawerEmpty"]
text = "No spare flash drives."
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Shop" type="Button" parent="Panes/Main/Scroll/Content/Home/Stack/DrawerEmpty"]
focus_mode = 0
mouse_default_cursor_shape = 2
text = "Buy used ones on DeadDrive.oc"
theme_override_font_sizes/font_size = 16

[node name="Separator" type="HSeparator" parent="Panes/Main/Scroll/Content/Home/Stack"]

[node name="SystemCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack"]
text = "System"
mouse_filter = 2
theme_type_variation = &"MailStrong"

[node name="System" type="GridContainer" parent="Panes/Main/Scroll/Content/Home/Stack"]
columns = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 4

[node name="EditionCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "Edition"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Edition" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "OS Desktop Edition  ·  Version 1.0"
mouse_filter = 2
theme_override_font_sizes/font_size = 16

[node name="TypeCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "System type"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Type" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "Virtual desktop"
mouse_filter = 2
theme_override_font_sizes/font_size = 16

[node name="NetworkCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "Network"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Network" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "Local OS web"
mouse_filter = 2
theme_override_font_sizes/font_size = 16

[node name="PortsCaption" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
text = "USB ports"
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Ports" type="Label" parent="Panes/Main/Scroll/Content/Home/Stack/System"]
unique_name_in_owner = true
text = ""
mouse_filter = 2
theme_override_font_sizes/font_size = 16

[node name="Folder" type="VBoxContainer" parent="Panes/Main/Scroll/Content"]
unique_name_in_owner = true
visible = false
theme_override_constants/separation = 0

[node name="Columns" type="MarginContainer" parent="Panes/Main/Scroll/Content/Folder"]
theme_override_constants/margin_left = 54
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 6

[node name="Row" type="HBoxContainer" parent="Panes/Main/Scroll/Content/Folder/Columns"]
theme_override_constants/separation = 12

[node name="Name" type="Label" parent="Panes/Main/Scroll/Content/Folder/Columns/Row"]
size_flags_horizontal = 3
text = "Name"
mouse_filter = 2
theme_type_variation = &"MailMuted"

[node name="Type" type="Label" parent="Panes/Main/Scroll/Content/Folder/Columns/Row"]
custom_minimum_size = Vector2(130, 0)
text = "Type"
mouse_filter = 2
theme_type_variation = &"MailMuted"

[node name="Size" type="Label" parent="Panes/Main/Scroll/Content/Folder/Columns/Row"]
custom_minimum_size = Vector2(90, 0)
text = "Size"
horizontal_alignment = 2
mouse_filter = 2
theme_type_variation = &"MailMuted"

[node name="Rows" type="VBoxContainer" parent="Panes/Main/Scroll/Content/Folder"]
unique_name_in_owner = true
theme_override_constants/separation = 0

[node name="FolderEmpty" type="Label" parent="Panes/Main/Scroll/Content/Folder"]
unique_name_in_owner = true
text = "This folder is empty."
horizontal_alignment = 1
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Preview" type="PanelContainer" parent="Panes"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(320, 0)
theme_type_variation = &"MailReader"

[node name="Stack" type="VBoxContainer" parent="Panes/Preview"]
theme_override_constants/separation = 8

[node name="FileIcon" type="TextureRect" parent="Panes/Preview/Stack"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
size_flags_horizontal = 0
mouse_filter = 2
texture = ExtResource("file")
expand_mode = 1
stretch_mode = 5

[node name="FileName" type="Label" parent="Panes/Preview/Stack"]
unique_name_in_owner = true
mouse_filter = 2
autowrap_mode = 3
theme_type_variation = &"MailStrong"

[node name="FileMeta" type="Label" parent="Panes/Preview/Stack"]
unique_name_in_owner = true
mouse_filter = 2
theme_type_variation = &"MailMuted"

[node name="FileText" type="TextEdit" parent="Panes/Preview/Stack"]
unique_name_in_owner = true
size_flags_vertical = 3
editable = false
wrap_mode = 1
theme_override_font_sizes/font_size = 16

[node name="NoPreview" type="Label" parent="Panes/Preview/Stack"]
unique_name_in_owner = true
size_flags_vertical = 3
text = "No preview available for this file."
autowrap_mode = 3
mouse_filter = 2
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 16

[node name="Copy" type="Button" parent="Panes/Preview/Stack"]
unique_name_in_owner = true
focus_mode = 0
mouse_default_cursor_shape = 2
text = "Copy text"

[connection signal="pressed" from="Ribbon/Row/Back" to="." method="go_back"]
[connection signal="pressed" from="Ribbon/Row/Up" to="." method="go_up"]
[connection signal="pressed" from="Ribbon/Row/Eject" to="." method="eject_current"]
[connection signal="pressed" from="Ribbon/Row/DestroyCurrent" to="." method="_destroy_current_pressed"]
[connection signal="pressed" from="Panes/Sidebar/List/ThisPC" to="." method="show_home"]
[connection signal="pressed" from="Panes/Main/Scroll/Content/Home/Stack/DrawerEmpty/Shop" to="." method="_open_shop"]
[connection signal="pressed" from="Panes/Preview/Stack/Copy" to="." method="copy_text"]
