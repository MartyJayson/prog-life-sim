[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/apps/qa_debug.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/qa/qa_check_row.tscn" id="row"]

[node name="QaDebug" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("script")
row_scene = ExtResource("row")

[node name="Ribbon" type="PanelContainer" parent="."]
theme_type_variation = &"MailRibbon"

[node name="Stack" type="VBoxContainer" parent="Ribbon"]
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Ribbon/Stack"]
unique_name_in_owner = true
text = "TinySoft QA  ·  Test report"
theme_type_variation = &"MailStrong"
text_overrun_behavior = 3

[node name="Session" type="Label" parent="Ribbon/Stack"]
unique_name_in_owner = true
text = "No active session"
theme_type_variation = &"MailMuted"
theme_override_font_sizes/font_size = 13
text_overrun_behavior = 3

[node name="Hint" type="Label" parent="."]
text = "Test every control on the site. Click a check once if it works, twice if it is broken."
autowrap_mode = 3
theme_type_variation = &"MailMuted"

[node name="List" type="PanelContainer" parent="."]
size_flags_vertical = 3
theme_type_variation = &"MailList"

[node name="Scroll" type="ScrollContainer" parent="List"]
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="List/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Idle" type="Label" parent="List"]
unique_name_in_owner = true
size_flags_vertical = 4
text = "Open a test link from your TinySoft task letter to start a session."
horizontal_alignment = 1
autowrap_mode = 3
theme_type_variation = &"MailMuted"

[node name="Footer" type="HBoxContainer" parent="."]
theme_override_constants/separation = 10

[node name="Progress" type="Label" parent="Footer"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = "0 of 0 checked"
theme_type_variation = &"MailMuted"
autowrap_mode = 3

[node name="Submit" type="Button" parent="Footer"]
unique_name_in_owner = true
text = "SUBMIT"
disabled = true
focus_mode = 0
mouse_default_cursor_shape = 2
theme_type_variation = &"QaSubmit"

[connection signal="pressed" from="Footer/Submit" to="." method="_submit"]
