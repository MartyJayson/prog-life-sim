[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/mail/mail_row.gd" id="script"]

[node name="MailRow" type="Button"]
custom_minimum_size = Vector2(0, 86)
focus_mode = 0
mouse_default_cursor_shape = 2
toggle_mode = true
theme_type_variation = &"MailRow"
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Unread" type="ColorRect" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(4, 0)
layout_mode = 2
mouse_filter = 2
color = Color(1, 0.69, 0.25, 1)

[node name="Lines" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 1
alignment = 1

[node name="Top" type="HBoxContainer" parent="Margin/Row/Lines"]
layout_mode = 2
mouse_filter = 2

[node name="Sender" type="Label" parent="Margin/Row/Lines/Top"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 18
text_overrun_behavior = 3

[node name="Date" type="Label" parent="Margin/Row/Lines/Top"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"MailMuted"

[node name="Subject" type="Label" parent="Margin/Row/Lines"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 16
text_overrun_behavior = 3

[node name="Preview" type="Label" parent="Margin/Row/Lines"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"MailMuted"
text_overrun_behavior = 3
