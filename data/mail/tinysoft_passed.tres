[gd_resource type="Resource" script_class="MailMessage" format=3]

[ext_resource type="Script" path="res://scripts/mail/mail_message.gd" id="script"]

[resource]
script = ExtResource("script")
sender_name = "Dana Whitfield, QA Lead"
sender_address = "qa@tinysoft.oc"
subject = "Task {task} accepted — next task {next_task}"
body = "Hi,

Your report for task {task} has been reviewed and [b]accepted[/b]. {paid} has been transferred to your OS Bank account.

Your next build is ready for testing.

[b]Task {next_task}:[/b] {link}
Checklist: {checks} checks, 1 to 3 defects. Payment on acceptance: {reward}.

Thanks,
Dana Whitfield
QA Lead, TinySoft Inc."
